{
  "manifest_version": 3,
  "name": "LeetCode Auto-Sync",
  "version": "1.0",
  "description": "Commits accepted LeetCode solutions to GitHub automatically.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:7337/*",
    "http://127.0.0.1:7337/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "css": ["toast.css"],
      "run_at": "document_idle"
    }
  ]
}
